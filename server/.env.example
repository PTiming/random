# Server Configuration
NODE_ENV=development
PORT=5000

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/mern_social_moodle

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Moodle Configuration
MOODLE_URL=https://your-moodle-instance.com
MOODLE_TOKEN=your_moodle_web_service_token
MOODLE_SERVICE=moodle_mobile_app
MOODLE_OAUTH_CLIENT_ID=your_oauth_client_id
MOODLE_OAUTH_CLIENT_SECRET=your_oauth_client_secret
MOODLE_WEBHOOK_SECRET=your_moodle_webhook_secret

# Firebase Cloud Messaging
FCM_PROJECT_ID=your_firebase_project_id
FCM_PRIVATE_KEY=your_firebase_private_key
FCM_CLIENT_EMAIL=your_firebase_client_email

# Email Configuration (SendGrid/SMTP)
EMAIL_SERVICE=sendgrid
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_USER=apikey
EMAIL_PASS=your_sendgrid_api_key
EMAIL_FROM=noreply@yourdomain.com

# SMS Configuration (Twilio - optional)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Client URL (for CORS)
CLIENT_URL=http://localhost:3000

# Sync Configuration
SYNC_INTERVAL_MS=3600000
ENABLE_REALTIME_SYNC=true
